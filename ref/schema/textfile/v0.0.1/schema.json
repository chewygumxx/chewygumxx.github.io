{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id":     "https://cgxx.dev/ref/schema/textfile/v0.0.1/schema.json",

    "title": "Text file embedded metadata block",
    "description": "Embedded metadata block object containing data pertaining to file.",

    "type": "object",
    "required": [ "path", "ctime", "schema" ],
    "additionalProperties": false,
    "properties": {
        "path": {
            "type": "string",
            "description": "Intended filepath, relative or absolute per context (git repo, user home, system root).",
            "examples": [
                ":/src/main.rs",
                "~/.config/nvim/lua/spec/nvim-treesitter.lua",
                "/etc/fstab"
            ]
        },
        "ctime": {
            "type": "string",
            "description": "When this object was originally created.",
            "format": "date",
            "examples": [ "2026-08-08", "2020-12-21", "1991-12-25" ]
        },
        "schema": {
            "type": "string",
            "description": "URL of the schema this object conforms.",
            "format": "uri",
            "examples": [ "https://cgxx.dev/ref/schema/textfile/v0.0.1/schema.json" ]
        },
        "desc": {
            "type": "string",
            "description": "(Optional) Brief soft-maximum 3 sentence description of file",
            "examples": [
                "[Zsh Plugin] Alias organisation wrapper",
                "Proton Mail sieve filters for automatic label and decay of received email",
                "Parses a quotes.json file, formats context, prints accordingly. Utilised as a shell post-initalisation splash.",
                "Source file to initialise Zsh for repository. Repository root must be the real parent directory of this file."
            ]
        },
        "tags": {
            "type": "array",
            "description": "(Optional) Indexing keys. Hierarchically delimited by slash/solidus '/'",
            "uniqueItems": true,
            "items": {
                "type": "string",
                "pattern": "^[a-z0-9\\-]+(?:/[a-z0-9\\-]+)*$",
                "examples": [
                    "scratch",
                    "log",
                    "todo/procure",
                    "util/curl",
                    "util/zsh/func"
                ]
            }
        },
        "pgp": {
            "type": "array",
            "description": "(Optional) Recipient PGP public keys to encrypt file",
            "uniqueItems": true,
            "items": {
                "type": "object",
                "description": "Relevant PGP recipient encryption details",
                "additionalProperties": false,
                "required": [ "fprint", "url" ],
                "properties": {
                    "fprint": {
                        "type": "string",
                        "description": "PGP public key fingerprint to encrypt file. Whitespace insensitive.",
                        "examples": [
                            "7F5F 2679 07B2 C455 9DB3 60DB 2294 BA7D 2B22 98B9",
                            "E5593813680DDB509CAAE79AA97180E5C2A37A37"
                        ]
                    },
                    "url": {
                        "type": "string",
                        "description": "PGP public key file URL to encrypt file.",
                        "format": "uri",
                        "examples": [
                            "https://cgxx.dev/ref/pgp/chewygumxx-public.pgp.asc",
                            "https://blog.probablyfine.co.uk/gpg.asc"
                        ]
                    }
                }
            }
        },
        "spdx": {
            "type": "object",
            "description": "(Optional) SPDX Specification Data, should NOT be employed as substitute of the standard notation summarised here: https://reuse.software/faq/#quick-summary",
            "additionalProperties": false,
            "required": [ "FileCopyrightText", "License-Identifier" ],
            "properties": {
                "FileCopyrightText": {
                    "type": "string",
                    "description": "PGP public key file URL to encrypt file.",
                    "examples": [ "2026 chewygumxx", "2025 chewygumxx <cgumxx@pm.me>" ]
                },
                "License-Identifier": {
                    "type": "string",
                    "description": "License identifier according to: https://spdx.org/licenses/",
                    "examples": [ "MIT", "GPL-3.0-or-later", "CC-BY-3.0-AU" ]
                }
            }
        },
        "git": {
            "type": "object",
            "description": "(Optional) Details of associated git repository",
            "required": [ "slug" ],
            "additionalProperties": false,
            "properties": {
                "slug": {
                    "type": "string",
                    "description": "Repository slug. Format: <username>/<repository>",
                    "pattern": "^[\\w](?:[\\w]|-(?=[\\w])){0,38}/[\\w\\-\\.]+$",
                    "examples": [ "chewygumxx/zsh-shell-template", "fairyglade/ly", "hyprwm/Hyprland" ]
                },
                "name": {
                    "type": "string",
                    "description": "Repository name",
                    "pattern": "^[\\w\\-\\.]+$",
                    "examples": [ "dotfiles", "zsh-shell-template", "print-quote", "json2http" ]
                },
                "user": {
                    "type": "string",
                    "description": "Username repository is most associated",
                    "pattern": "^[\\w](?:[\\w]|-(?=[\\w])){0,38}$",
                    "examples": [ "chewygumxx", "fairyglade", "clason" ]
                },
                "remotes": {
                    "type": "array",
                    "description": "(Optional) Remote repository URLs",
                    "items": {
                        "type": "object",
                        "required": [ "name", "url" ],
                        "additionalProperties": false,
                        "properties": {
                            "name": {
                                "type": "string",
                                "pattern": "^[\\w](?:[\\w]|-(?=[\\w])){0,38}$",
                                "examples": [ "origin", "github", "codeberg" ]
                            },
                            "url": {
                                "type": "string",
                                "format": "uri",
                                "examples": [
                                    "git@github.com:chewygumxx/chezmoi-apply-xattr.git",
                                    "https://github.com/stsewd/tree-sitter-comment.git",
                                    "https://codeberg.org/fairyglade/ly.git"
                                ]
                            }
                        }
                    }
                }
            }
        },
        "urls": {
            "type": "array",
            "description": "(Optional) Relevant URLs",
            "items": {
                "type": "object",
                "required": [ "url" ],
                "additionalProperties": false,
                "properties": {
                    "url": {
                        "type": "string",
                        "description": "URL Address",
                        "format": "uri",
                        "examples": [
                            "https://en.wikipedia.org/wiki/ISO_8601",
                            "https://www.getdnote.com/",
                            "https://buddy.works/guides/git-crypt"
                        ]
                    },
                    "tag": {
                        "description": "(Optional) Terse descriptive label/type",
                        "enum": [ "home", "repo", "doc", "ref", "db", "api", "author", "schema", "alt" ]
                    },
                    "title": {
                        "type": "string",
                        "description": "(Optional) Free-form descriptive string",
                        "examples": [
                            "ISO 8601 - Wikipedia",
                            "Git - Git Attributes",
                            ".chezmoiignore - chezmoi",
                            "Generating a POSIX random number? - Unix Linux Community",
                            "TUI Terminal Tools - Terminal Trove"
                        ]
                    }
                }
            }
        }
    }
}
